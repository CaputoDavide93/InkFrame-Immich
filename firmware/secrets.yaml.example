# Copy to secrets.yaml next to immich-frame.yaml and fill in. secrets.yaml is gitignored.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
fallback_password: "CHANGE_ME"          # the panel's own hotspot if Wi-Fi fails

# CHANGE ME. Must be 32 bytes of base64 and not all zeros; this one is only an example.
# Generate your own: openssl rand -base64 32
immich_frame_api_key: "nU6qtZBOjxCVmi9zZl7Sh6qN9XKR7cTnJzWgMjgpkP4="
immich_frame_ota_password: "CHANGE_ME"

# Where the renderer answers. Plain HTTP, reachable from the panel's network.
frame_server_url: "http://immich-frame.example.lan:8099"
