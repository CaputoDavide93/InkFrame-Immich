# Renderer configuration. Copy to .env next to docker-compose.yml.
# Every variable the code reads is listed; blank means "use the default in the table in docs/api.md".

# Required
IMMICH_URL=http://immich.example.lan:2283
# One of the two. The file form is what docker-compose.yml uses (a Docker secret).
IMMICH_API_KEY_FILE=/run/secrets/immich_frame_api_key
IMMICH_API_KEY=

# Listener
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8099

# Persistence
STATE_FILE=/data/state.json

# Selection
RECENT_MEMORY=120
MIN_PERSON_PHOTOS=20
PEOPLE_RECOUNT_SECONDS=86400
CANDIDATES=20
MAX_BUSYNESS=22
REQUIRE_CAMERA=1

# Render treatment defaults (runtime-settable from Home Assistant)
RENDER_SMOOTH=0.45
RENDER_CURVE=0.35
RENDER_EDGE=55
RENDER_CONTRAST=1.05

# Panel wake parameters (runtime-settable from Home Assistant)
SLEEP_HOURS=168
OTA_WINDOW_SECONDS=20

# Liveness files and logging
HEARTBEAT_FILE=/tmp/immichframe-heartbeat
LAST_OK_FILE=/tmp/immichframe-render-ok
LOG_LEVEL=INFO
